{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// Beyond `strict` (see Strictness of the interface code in docs/technical-choices.md):
		// `list[0]` and `table[key]` may be `undefined`, as the core forbids indexing.
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		// Only types that can be erased (no enum, no namespace): Node.js runs the scripts by
		// stripping their types, without compiling them.
		"erasableSyntaxOnly": true,
		"types": ["$app/types", "node"]
	},
	"include": [
		"src",
		"scripts",
		"vite.config.ts",
		"vitest-node-client.ts",
		"prettier.config.js",
		"eslint.config.js"
	],
	// The glue generated by wasm-bindgen is typed by its `.d.ts` files, not checked as code.
	"exclude": ["src/lib/wasm/*.js"]
}
